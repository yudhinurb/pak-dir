# ==============================================================================
# KONFIGURASI AI-ONLY TECH COMPANY (UBUNTU 2GB RAM EDITION)
# ==============================================================================

# 1. Discord Virtual Office (Wajib untuk komunikasi CTO)
DISCORD_BOT_TOKEN=masukkan_token_bot_discord_elu_disini

# 2. Multi-Provider Free LLM API Keys (Isi minimal 2-3 agar rotasi otomatis jalan mulus)
# Google AI Studio (Gratis - Context 1M Token untuk EM & Architect): https://aistudio.google.com/
GEMINI_API_KEY=

# Groq Cloud (Gratis - Super cepat untuk Llama 3.3 70B & Qwen): https://console.groq.com/
GROQ_API_KEY=

# Cerebras Inference (Gratis - Kecepatan ekstrem untuk koding): https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Mistral La Plateforme (Gratis - Model spesialis koding Codestral): https://console.mistral.ai/
MISTRAL_API_KEY=

# OpenRouter (Gratis untuk model berakhiran :free seperti deepseek-r1:free & qwen3-coder:free): https://openrouter.ai/
OPENROUTER_API_KEY=

# 3. GitHub Token (Opsional - Untuk auto push branch & buat Pull Request)
GITHUB_TOKEN=
