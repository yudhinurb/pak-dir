[Unit]
Description=PakDir AI Engineering Control Plane & Supervisor
After=network.target

[Service]
Type=simple
User=yudhinurb
Group=yudhinurb
WorkingDirectory=/home/yudhinurb/pak-dir
EnvironmentFile=/home/yudhinurb/pak-dir/.env
ExecStart=/home/yudhinurb/pak-dir/.venv/bin/python -m orchestrator.discord_bot
Restart=always
RestartSec=5
# Resident memory cap ensuring the control plane leaves ample room for applications
MemoryMax=250M

[Install]
WantedBy=multi-user.target
